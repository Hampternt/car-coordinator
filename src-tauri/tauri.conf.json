{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Car Coordinator",
  "version": "0.2.3",
  "identifier": "no.m.carcoordinator",
  "build": {
    "frontendDist": "../docs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Car Coordinator",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
