# /opt/carsync/.env — read by carsync.service. Copy, fill in, chmod 600.
# Every variable is described in relay/PROTOCOL.md §7.

# 127.0.0.1, not localhost: nginx proxies to 127.0.0.1:3010.
RELAY_BIND=127.0.0.1:3010
RELAY_DATA=/opt/carsync/data
# The owner's code for creating a room. Unset or empty = nobody can create one.
# Make one with: openssl rand -base64 24
RELAY_CREATE_CODE=
# The pages allowed to open a WebSocket (exact match). This is the default:
RELAY_ORIGINS=https://hampternt.github.io,http://tauri.localhost
# RELAY_MAX_ROOMS=20
# RELAY_MAX_DISK_BYTES=2147483648
